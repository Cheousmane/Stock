APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# PRODUCTION: APP_DEBUG must be false. Never deploy with true.
APP_DEBUG=false
APP_URL=http://localhost

# PRODUCTION: IPs/CIDRs des proxies de confiance (LB, Cloudflare).
# Défaut '*' = fait confiance à X-Forwarded-For de n'importe qui.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=facturation_user
# DB_PASSWORD=strong_random_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# PRODUCTION: SESSION_SECURE_COOKIE=true (requires HTTPS)
# PRODUCTION: SESSION_SAME_SITE=lax (or 'strict')

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
# MAIL_PASSWORD must be set via secure environment variable or secret manager
# Never commit actual passwords to version control
MAIL_PASSWORD=
# Chiffrement SMTP (tls pour le port 587, ssl pour le 465). DOIT correspondre
# au port : sans lui, Gmail refuse la connexion.
MAIL_ENCRYPTION=tls
# PRODUCTION: borne d'attente SMTP en secondes (évite les requêtes bloquées).
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# PRODUCTION email (recommandé) : Resend via API HTTP (pas de port SMTP à ouvrir).
# 1. Crée un compte sur https://resend.com + vérifie ton domaine d'envoi.
# 2. RESEND_API_KEY=re_... et MAIL_MAILER=failover (Resend puis repli SMTP),
#    ou MAIL_MAILER=resend (Resend uniquement).
RESEND_API_KEY=
# MAIL_MAILER=failover

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (connexion/inscription avec Google)
# CLIENT_ID partagé backend + frontend (GIS). Créer sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID="${GOOGLE_CLIENT_ID}"

# CORS (production: lister les origines HTTPS exactes, jamais "*")
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Requested-With,X-Tenant-Slug

# Google Analytics
VITE_GA_MEASUREMENT_ID=

# Stripe (Laravel Cashier)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Cashier uses STRIPE_SECRET for API calls
# CASHIER_CURRENCY=xof
# CASHIER_CURRENCY_LOCALE=fr_FR
